# Déjalo vacío para usar el mismo origen: en desarrollo Vite hace proxy de
# /auth, /sessions, /scenarios, /health, /ready y /ai hacia el backend
# (VITE_PROXY_TARGET, por defecto http://127.0.0.1:8000).
# En despliegue, define aquí la URL del backend o sirve ambos tras el mismo dominio.
VITE_API_BASE_URL=

# Backend al que apunta el proxy de desarrollo.
VITE_PROXY_TARGET=http://127.0.0.1:8000
